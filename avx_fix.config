// Fix for exit 132 (SIGILL) on hosts without AVX2 support (e.g. Intel Xeon E7-4850).
// The pipeline's default containers pin the standard `polars` PyPI/conda build,
// which crashes with "Illegal instruction" on any CPU lacking AVX2.
// This overrides the affected process(es) to use a container built with
// `polars-lts-cpu` instead, which is functionally identical but compiled
// without the AVX2 requirement.
process {
    withName: '.*:ANNOTATE_(COMBINED|PER_SAMPLE|PER_SAMPLE_TOOL):BED2GTF' {
        container = '/data/rubem/jenny/apptainer_cache/polars_lts_cpu_bed2gtf.sif'
    }
    // Fix for polars/Rayon thread-pool deadlock: with 80 host CPUs visible
    // and no cgroup restriction, polars spawns ~80 worker threads. Any
    // process that builds a query touching all samples at once (joins,
    // shift-tolerance grouping) can deadlock that thread pool once the data
    // is large enough. Confirmed directly on the real JOIN_GENE input
    // (78,692 rows x 48 samples): it hung indefinitely (0 CPU progress over
    // 60s, every thread parked in futex_wait_queue) with the default thread
    // count, AND still hung the same way capped at 6 threads -- only
    // capping to 1 thread avoided the deadlock (verified against the exact
    // real input, ~11s). A synthetic same-shape dataset had *not* reproduced
    // the hang at 6 threads, so this real data has some further property
    // that lowers the thread count needed to trigger it; 1 is the value
    // actually confirmed safe. Applied to COMBINE_TOOLS_PER_SAMPLE/
    // COMBINE_SAMPLES and INVESTIGATE_SHIFTS too as a precaution, since they
    // process all samples' data in one query too, even though they haven't
    // hit this yet.
    withName: '.*:INVESTIGATE_SHIFTS' {
        container = '/data/rubem/jenny/apptainer_cache/polars_lts_cpu_shifts.sif'
        containerOptions = '--env POLARS_MAX_THREADS=1'
    }
    withName: '.*:(COMBINE_TOOLS_PER_SAMPLE|COMBINE_SAMPLES)' {
        container = '/data/rubem/jenny/apptainer_cache/polars_lts_cpu_filter.sif'
        containerOptions = '--env POLARS_MAX_THREADS=1'
    }
    withName: '.*:CIRIQUANT:(JOIN_GENE|JOIN_CIRC)' {
        container = '/data/rubem/jenny/apptainer_cache/polars_lts_cpu_join_samples.sif'
        containerOptions = '--env POLARS_MAX_THREADS=1'
    }

    // NOTE on how to pass env vars into these containers (verified directly,
    // both other approaches silently do nothing):
    //   - `beforeScript` runs on the HOST before nxf_launch()'s
    //     `env - PATH=... singularity exec --no-home ...` wrapper, which
    //     strips everything not explicitly whitelisted before the container
    //     even starts -- any export set via beforeScript never arrives.
    //   - Nextflow's own `env.VAR = 'x'` process/config directive: tested
    //     directly, produces no SINGULARITYENV_* export at all for this
    //     Nextflow version -- silently has no effect.
    //   - `containerOptions = '--env VAR=x'` (used above): the one that
    //     actually works, confirmed with a minimal standalone test.
    // The one exception is HOME itself: apptainer/singularity explicitly
    // refuses `--env HOME=...` for security reasons, so the gtftk
    // "Read-only file system: '/home/rubem'" fix could not use this
    // mechanism either -- HOME can only be fixed by exporting it from
    // *inside* the container's own shell, i.e. as the first line of the
    // module's actual script. See modules/local/pygtftk/tabulate/main.nf.
}
